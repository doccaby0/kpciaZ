rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lectures/{lectureId} {
      // Reject legacy lecture IDs from stale client tabs
      allow write: if !lectureId.matches('^lect_hist_.*') && !lectureId.matches('^lect_open_.*');
      allow read: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
