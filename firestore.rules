rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /lectures/{lectureId} {
      // Allow create, update, and delete of lectures while protecting legacy historical records
      allow create, update: if !lectureId.matches('^lect_hist_.*');
      allow delete: if !lectureId.matches('^lect_hist_.*');
      allow read: if true;
    }
    match /users/{userId} {
      // Reject mock instructors from stale client tabs, but permit deletion
      allow delete: if true;
      allow create, update: if !userId.matches('^user_(gu_gyojun|choi_wonseok|kang_taeyang|park_junhyuk|lee_soyeon|jung_woosung|kim_minjae|han_jieun|yoon_seojun|song_minji|cho_hyunwoo|kim_dohyun)$');
      allow read: if true;
    }
    match /programs/{programId} {
      allow read, write: if true;
    }
    match /proposals/{proposalId} {
      allow read, write: if true;
    }
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    match /metadata/{metaId} {
      allow read, write: if true;
    }
  }
}
