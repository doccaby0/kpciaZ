{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Instructor profiles containing user tier, credentials, contact, and profile details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "tier": { 
          "type": "string", 
          "enum": ["Prestige Member", "Prestige Associate", "Prestige Professional", "Prestige Master", "Prestige Elite", "Prestige Legend"] 
        },
        "mileage": { "type": "integer" },
        "isAdmin": { "type": "boolean" },
        "isApproved": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "loginId": { "type": "string" },
        "password": { "type": "string" },
        "organizationName": { "type": "string" },
        "lectureCount": { "type": "integer" },
        "averageRating": { "type": "number" },
        "lectureRatings": { "type": "array" },
        "assistantEvaluations": { "type": "array" },
        "profileCard": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "bio": { "type": "string" },
            "specialties": { "type": "array" },
            "career": { "type": "array" },
            "education": { "type": "array" },
            "contactEmail": { "type": "string" },
            "contactPhone": { "type": "string" },
            "imageUrl": { "type": "string" },
            "pdfUrl": { "type": "string" },
            "cardTheme": { "type": "string" },
            "bankAccount": { "type": "string" },
            "region": { "type": "string" },
            "websiteUrl": { "type": "string" }
          }
        },
        "badges": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "tier", "mileage"]
    },
    "Lecture": {
      "title": "Lecture Request",
      "description": "Corporate lecture postings, matching, and completed historical lecture archives.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "companyName": { "type": "string" },
        "partnerCompany": { "type": "string" },
        "description": { "type": "string" },
        "targetTier": { 
          "type": "string", 
          "enum": ["Prestige Member", "Prestige Associate", "Prestige Professional", "Prestige Master", "Prestige Elite", "Prestige Legend"] 
        },
        "budget": { "type": "integer" },
        "mileageRoyalty": { "type": "integer" },
        "programId": { "type": "string" },
        "programTitle": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "duration": { "type": "string" },
        "location": { "type": "string" },
        "attendees": { "type": "integer" },
        "managerName": { "type": "string" },
        "managerPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "assigned", "completed"] },
        "settlementStatus": { "type": "string", "enum": ["pending", "completed"] },
        "assignedTo": { "type": "string" },
        "assignedName": { "type": "string" },
        "applicants": { "type": "array" },
        "mainHours": { "type": "number" },
        "assistantHours": { "type": "number" },
        "materialCost": { "type": "integer" },
        "budgetOption": { "type": "string" },
        "assistantId": { "type": "string" },
        "assistantName": { "type": "string" },
        "assistantEvaluated": { "type": "boolean" },
        "lectureRating": { "type": "number" },
        "surveyUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "targetTier", "status"]
    },
    "Program": {
      "title": "Educational Program",
      "description": "Programs developed by the association or members with curriculum and royalties.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "royaltyRate": { "type": "integer" },
        "curriculum": { "type": "array" },
        "targetAudience": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "surveyUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "authorId", "authorName"]
    },
    "Transaction": {
      "title": "Mileage Transaction",
      "description": "Records of mileage transfers, royalty payments, and payouts.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["royalty", "admin_adjust", "lecture_payout", "program_register"] },
        "amount": { "type": "integer" },
        "description": { "type": "string" },
        "relatedId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "amount", "createdAt"]
    },
    "Proposal": {
      "title": "Partnership Proposal",
      "description": "Corporate partnership proposals submitted by companies or external clients.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "proposerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "accepted", "declined"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyName", "proposerName", "email", "phone", "title", "content", "status", "createdAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    },
    "lectures/{lectureId}": {
      "schema": "Lecture",
      "description": "Lecture requests and assignments"
    },
    "programs/{programId}": {
      "schema": "Program",
      "description": "Program assets and owner information"
    },
    "transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Mileage transactions"
    },
    "proposals/{proposalId}": {
      "schema": "Proposal",
      "description": "Corporate partnership proposals"
    }
  }
}
